<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!-- ToolBar fork: flat, dark, modern theme. Switch back any time in Properties > Theme. -->

    <!-- Palette -->
    <Color x:Key="ModernAccentColor">#4CC2FF</Color>
    <SolidColorBrush x:Key="ModernAccent" Color="{StaticResource ModernAccentColor}" />
    <SolidColorBrush x:Key="ModernButton" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ModernButtonHover" Color="#383838" />
    <SolidColorBrush x:Key="ModernButtonPressed" Color="#262626" />
    <SolidColorBrush x:Key="ModernButtonActive" Color="#404040" />
    <SolidColorBrush x:Key="ModernStroke" Color="#3A3A3A" />

    <system:Boolean x:Key="InvertSystemNotifyIcons">False</system:Boolean>

    <SolidColorBrush x:Key="ButtonHighlight" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ButtonInnerHighlight" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ButtonLight" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ButtonFace" Color="#1C1C1C" />
    <SolidColorBrush x:Key="ButtonShadow" Color="#141414" />
    <SolidColorBrush x:Key="ButtonDarkShadow" Color="#000000" />
    <SolidColorBrush x:Key="ButtonFlashingFace" Color="#B2541A" />

    <SolidColorBrush x:Key="ButtonForeground" Color="#EDEDED" />
    <SolidColorBrush x:Key="ButtonFlashingForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ClockForeground" Color="#EDEDED" />

    <SolidColorBrush x:Key="InputLanguageForeground" Color="#EDEDED" />
    <SolidColorBrush x:Key="InputLanguageBackground" Color="#2B2B2B" />
    <SolidColorBrush x:Key="InputLanguageSelectorForeground" Color="#EDEDED" />

    <SolidColorBrush x:Key="ToolTipBackground" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="#EDEDED" />

    <FontFamily x:Key="GlobalFontFamily">Segoe UI</FontFamily>
    <system:Double x:Key="GlobalFontSize">12</system:Double>

    <Thickness x:Key="TaskButtonMargin" Left="2" Right="2" />

    <!-- Start icon: four rounded tiles in the accent color -->
    <DrawingImage x:Key="StartIconImage">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="{StaticResource ModernAccent}">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry Rect="0,0,7,7" RadiusX="1.2" RadiusY="1.2" />
                        <RectangleGeometry Rect="9,0,7,7" RadiusX="1.2" RadiusY="1.2" />
                        <RectangleGeometry Rect="0,9,7,7" RadiusX="1.2" RadiusY="1.2" />
                        <RectangleGeometry Rect="9,9,7,7" RadiusX="1.2" RadiusY="1.2" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Taskbar background: flat with a hairline on the edge facing the screen -->
    <Style TargetType="ContentControl"
           x:Key="Taskbar"
           BasedOn="{StaticResource Taskbar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border BorderThickness="0,1,0,0"
                            BorderBrush="{StaticResource ModernStroke}"
                            Background="{DynamicResource ButtonFace}"
                            Name="OuterBorder">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=AppBarEdge, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Top">
                            <Setter TargetName="OuterBorder" Property="BorderThickness" Value="0,0,0,1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=AppBarEdge, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Left">
                            <Setter TargetName="OuterBorder" Property="BorderThickness" Value="0,0,1,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=AppBarEdge, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="Right">
                            <Setter TargetName="OuterBorder" Property="BorderThickness" Value="1,0,0,0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Task buttons -->
    <Style TargetType="Button"
           x:Key="TaskButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{StaticResource ModernButton}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Face"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="8,2,6,2">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ModernButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ModernButtonPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button"
           x:Key="TaskButtonActive"
           BasedOn="{StaticResource TaskButton}">
        <Setter Property="Background" Value="{StaticResource ModernButtonActive}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Face"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#4A4A4A"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="7,1,5,1">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#474747" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button"
           x:Key="TaskButtonFlashing"
           BasedOn="{StaticResource TaskButton}">
        <Setter Property="Background" Value="{DynamicResource ButtonFlashingFace}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonFlashingForeground}" />
    </Style>

    <Style TargetType="ContentControl"
           x:Key="TaskButtonThumbnail">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="#2B2B2B"
                            BorderBrush="#454545"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6"
                            Margin="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Image"
           x:Key="TaskIcon">
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style TargetType="Image"
           x:Key="ToolbarIcon"
           BasedOn="{StaticResource TaskIcon}">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style TargetType="Image"
           x:Key="NotifyIcon"
           BasedOn="{StaticResource TaskIcon}">
        <Setter Property="Margin" Value="2" />
    </Style>

    <Style TargetType="Image"
           x:Key="StartIcon"
           BasedOn="{StaticResource TaskIcon}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Source" Value="{DynamicResource StartIconImage}" />
    </Style>

    <!-- Start button -->
    <Style TargetType="ToggleButton"
           x:Key="StartButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <Border x:Name="Face"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ModernButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ModernButtonActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBlock"
           x:Key="StartLabel"
           BasedOn="{StaticResource StartLabel}">
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- Quick Launch buttons -->
    <Style TargetType="Button"
           x:Key="ToolbarButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="4">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ModernButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ModernButtonPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Grips: a thin vertical hairline -->
    <Style TargetType="Thumb"
           x:Key="ToolbarThumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="3,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" Width="6">
                        <Border x:Name="Line"
                                Width="1"
                                HorizontalAlignment="Center"
                                Background="{StaticResource ModernStroke}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Highlight only when the taskbar is unlocked (i.e. the grip can actually be dragged) -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding Path=IsLocked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Line" Property="Background" Value="{StaticResource ModernAccent}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tray: flat, no sunken frame -->
    <Style TargetType="GroupBox"
           x:Key="Tray">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Padding="4,2" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBlock"
           x:Key="Clock"
           BasedOn="{StaticResource Clock}">
        <Setter Property="Margin" Value="10,0,6,0" />
    </Style>

    <Style TargetType="ToolTip"
           x:Key="{x:Type ToolTip}"
           BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="BorderBrush" Value="#454545" />
        <Setter Property="Padding" Value="6,3" />
    </Style>
</ResourceDictionary>
